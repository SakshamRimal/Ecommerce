APP_NAME=ecommerce-backend
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

#POSTGRES
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

#JWT
JWT_SECRET_KEY=generate_a_strong_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

#CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

#redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
ARQ_REDIS_URL=redis://localhost:6379/1
# Optional: set to e.g. redis://localhost:6379/2 in production for shared rate limits across workers
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/2

#SERVER
HOST=0.0.0.0
PORT=8000

#MAIL
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@yourshop.com
MAIL_FROM_NAME=YourShop
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

#Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PRODUCTS_INDEX=products

#MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=product-images
MINIO_REGION=us-east-1

#OPENTELEMETRY
OTEL_EXPORTER_ENDPOINT=localhost:4317

#LLM PROVIDERS (Priority: 1. Gemini Free -> 2. Grok / Groq Free -> 3. OpenAI Fallback)
GEMINI_API_KEY=your_gemini_free_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

GROK_API_KEY=your_grok_or_groq_free_api_key
GROK_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=sk-,....your-key...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_TOOL_ITERATIONS=5
